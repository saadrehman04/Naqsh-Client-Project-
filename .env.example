# ==============================================================================
# Naqsh Website Environment Variables
# Copy this file to .env.local for local development
# ==============================================================================

# Public Site URL (canonical SEO and OpenGraph generation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Contact Number (Pakistan country code +92)
NEXT_PUBLIC_WHATSAPP_NUMBER=923469171798

# Email Delivery via Resend (Inquiry Form)
# When RESEND_API_KEY is not provided, inquiries are logged to server console in dev.
RESEND_API_KEY=
CONTACT_TO_EMAIL=inquiries@naqsh.pk
CONTACT_FROM_EMAIL=consultation@naqsh.pk

# Sanity CMS Configuration (Optional / Phase 5)
# When omitted, the website automatically falls back to local data in src/content/
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Optional Analytics & Anti-spam
NEXT_PUBLIC_ANALYTICS_ID=
TURNSTILE_SECRET_KEY=
